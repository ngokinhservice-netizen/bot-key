# ==========================================
# MTK KEY BOT - ENVIRONMENT CONFIGURATION
# ==========================================

# --- Telegram Bot Settings ---
# Lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Telegram ID của Super Admin chính (để nhận thông báo đơn hàng mới, gửi tin khẩn cấp)
SUPER_ADMIN_TELEGRAM_ID=123456789

# --- Application Environment ---
# Environment: development / production
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=super-secret-key-change-this-in-production-min-32-chars
PORT=8000
HOST=0.0.0.0
WEB_BASE_URL=http://localhost:8000

# --- Database Settings ---
# Hỗ trợ SQLite (local dev) hoặc PostgreSQL (production VPS)
# Local SQLite: sqlite+aiosqlite:///./mtk_bot.db
# VPS PostgreSQL: postgresql+asyncpg://mtk_user:mtk_password@localhost:5432/mtk_key_bot
DATABASE_URL=sqlite+aiosqlite:///./mtk_bot.db

# --- SePay Payment Gateway Settings ---
# Cấu hình tại https://my.sepay.vn
# API Key của SePay để xác thực webhook gửi đến bot
SEPAY_API_KEY=sepay_api_key_here
# Số tài khoản ngân hàng nhận tiền
SEPAY_BANK_ACCOUNT=0123456789
# Tên ngân hàng thụ hưởng (MBBank, Vietcombank, Techcombank, ACB, VPBank,...)
SEPAY_BANK_NAME=MBBank
# Tên chủ tài khoản ngân hàng (viết hoa không dấu)
SEPAY_ACCOUNT_NAME=NGUYEN VAN A
# Bật chế độ thanh toán test (Chỉ dùng khi test local, KHÔNG bật trên production)
ALLOW_TEST_PAYMENTS=False

# --- Admin Dashboard Settings ---
# Tài khoản Super Admin mặc định khởi tạo lần đầu
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@MTK2026!
JWT_EXPIRE_MINUTES=1440

# --- Business Rules ---
# Thời gian hết hạn của đơn hàng chờ thanh toán (phút)
ORDER_EXPIRE_MINUTES=15
# Tỷ lệ hoa hồng mặc định cho cộng tác viên (phần trăm %)
DEFAULT_AFFILIATE_COMMISSION_PERCENT=10.0
